{
  "schemaVersion": 2,
  "runtime": [
    {
      "name": "three",
      "version": "0.180.0",
      "source": "jsdelivr",
      "license": "MIT",
      "purpose": "Pink WebGL presence and GLB/GLTF rendering"
    },
    {
      "name": "@pixiv/three-vrm",
      "version": "3.5.5",
      "source": "jsdelivr",
      "license": "MIT",
      "purpose": "VRM avatar loading and humanoid/expression runtime"
    },
    {
      "name": "@supabase/supabase-js",
      "version": "2.116.0",
      "source": "jsdelivr",
      "license": "MIT",
      "purpose": "Production-only authenticated Memory Cloud adapter; lazy-loaded when cloudMemory is enabled"
    },
    {
      "name": "Google Fonts / Inter",
      "version": "remote stylesheet",
      "source": "fonts.googleapis.com",
      "license": "OFL-1.1",
      "purpose": "UI typography"
    }
  ],
  "providers": [
    {
      "name": "Google Gemini Live API",
      "credential": "GEMINI_API_KEY",
      "credentialLocation": "Supabase Edge Function secret only",
      "purpose": "Primary realtime conversation and native audio"
    },
    {
      "name": "NVIDIA NIM",
      "credential": "NVIDIA_API_KEY",
      "credentialLocation": "Supabase Edge Function secret only",
      "purpose": "Nemotron reasoning fallback and specialist NVIDIA models"
    }
  ],
  "nvidiaSkills": [
    {"name":"rag-blueprint","status":"backend-required","purpose":"RAG knowledge layer"},
    {"name":"aiq-research","status":"backend-required","purpose":"Deep research"},
    {"name":"cuopt-install","status":"environment-required","purpose":"Decision optimization"},
    {"name":"accelerated-computing-cudf","status":"gpu-environment-required","purpose":"GPU dataframe acceleration"},
    {"name":"deepstream-import-vision-model","status":"gpu-environment-required","purpose":"Vision model pipeline integration"}
  ],
  "ci": [
    { "name": "actions/checkout", "version": "v4", "source": "GitHub Actions", "license": "MIT", "purpose": "repository checkout" },
    { "name": "actions/setup-node", "version": "v4", "source": "GitHub Actions", "license": "MIT", "purpose": "Node 22 setup" },
    { "name": "playwright", "version": "1.63.0", "source": "npm", "license": "Apache-2.0", "purpose": "desktop/mobile Chromium smoke gate" }
  ],
  "policy": {
    "runtimePackagesMustBePinned": true,
    "ciPackagesMustBePinned": true,
    "newDependencyRequiresLicenseRecord": true,
    "unknownLicenseBlocksProduction": true,
    "noBrowserProviderSecrets": true,
    "noEvidenceNoCapabilityClaim": true
  }
}
